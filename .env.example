# Salin ke .env lalu isi nilai sebenarnya: cp .env.example .env
PORT=3000

# PostgreSQL
DB_USER=
DB_PASSWORD=
DB_NAME=quiz
DB_PORT=5432
# DB_HOST=localhost   # default localhost; di Docker diatur oleh docker-compose.yml

# Admin awal: hanya dipakai saat tabel users masih kosong.
# Jika ADMIN_PASSWORD kosong, dibuat password acak dan dicetak di log saat pertama jalan.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Sumber avatar pemain (DiceBear style clay, API v10). Server memproxy + cache; jika tidak terjangkau, dipakai avatar cadangan.
# DICEBEAR_URL=https://api.dicebear.com/10.x/clay/svg
